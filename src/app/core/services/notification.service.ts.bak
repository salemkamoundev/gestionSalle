import { Injectable } from '@angular/core';
import { Messaging, getToken, onMessage } from '@angular/fire/messaging';
import { Firestore, doc, setDoc } from '@angular/fire/firestore';
import { Auth, authState } from '@angular/fire/auth';
import { filter, take, tap } from 'rxjs/operators';
import { Observable } from 'rxjs';

@Injectable({
  providedIn: 'root'
})
export class NotificationService {

  constructor(
    private messaging: Messaging,
    private firestore: Firestore,
    private auth: Auth
  ) { }

  /**
   * Initialise les notifications : demande la permission et sauvegarde le token
   * @param vapidKey Votre clé publique VAPID (depuis la console Firebase)
   */
  async initNotification(vapidKey: string) {
    try {
      // 1. Vérification des permissions navigateurs
      const permission = await Notification.requestPermission();
      if (permission !== 'granted') {
        console.warn('Permission de notification refusée');
        return;
      }

      // 2. Récupération du token FCM
      const token = await getToken(this.messaging, { vapidKey });
      
      if (token) {
        console.log('Token FCM récupéré :', token);
        // 3. Sauvegarde sécurisée (attend que l'auth soit prête)
        this.saveTokenToFirestore(token);
      } else {
        console.log('Aucun token FCM récupéré.');
      }

    } catch (error) {
      console.error('Erreur lors de l\'initialisation des notifications:', error);
    }
    
    // Écoute des messages au premier plan
    this.listenForMessages();
  }

  /**
   * Attend que l'utilisateur soit connecté pour sauvegarder le token
   */
  private saveTokenToFirestore(token: string) {
    // On utilise authState pour observer l'état de connexion
    authState(this.auth).pipe(
      filter(user => !!user), // On ne passe que si user existe (non null)
      take(1), // On ne le fait qu'une seule fois au chargement
      tap(async (user) => {
        if (!user) return;
        
        const userRef = doc(this.firestore, `users/${user.uid}`);
        try {
          // merge: true permet de ne pas écraser les autres infos du user
          await setDoc(userRef, { fcmToken: token }, { merge: true });
          console.log(`✅ Token FCM enregistré dans Firestore pour : ${user.email}`);
        } catch (err) {
          console.error('❌ Erreur écriture Firestore (Vérifiez les règles de sécurité):', err);
        }
      })
    ).subscribe();
  }

  private listenForMessages() {
    onMessage(this.messaging, (payload) => {
      console.log('Message reçu au premier plan :', payload);
      // Ajoutez ici votre logique d'affichage (Toast, Snakebar, etc.)
    });
  }
}
