<div class="bg-white rounded-lg shadow-md p-6">
  
  <div class="flex border-b border-gray-200 mb-6">
    <button 
      (click)="switchTab('client')"
      [class.border-blue-500]="activeTab === 'client'"
      [class.text-blue-600]="activeTab === 'client'"
      class="py-2 px-4 border-b-2 border-transparent hover:text-blue-500 font-medium text-sm focus:outline-none transition-colors duration-200">
      Règlements Clients
    </button>
    <button 
      (click)="switchTab('partner')"
      [class.border-blue-500]="activeTab === 'partner'"
      [class.text-blue-600]="activeTab === 'partner'"
      class="py-2 px-4 border-b-2 border-transparent hover:text-blue-500 font-medium text-sm focus:outline-none transition-colors duration-200">
      Règlements Partenaires
    </button>
  </div>

  <div *ngIf="activeTab === 'client'">
    <h3 class="text-lg font-semibold mb-4 text-gray-800">Suivi des paiements Client</h3>
    
    <div class="grid grid-cols-3 gap-4 mb-6 bg-blue-50 p-4 rounded text-center">
      <div>
        <span class="block text-gray-500 text-xs">Total Facturé</span>
        <span class="text-xl font-bold text-gray-800">{{ reservation?.totalAmount || 0 }} TND</span>
      </div>
      <div>
        <span class="block text-gray-500 text-xs">Total Payé</span>
        <span class="text-xl font-bold text-green-600">{{ reservation?.advancePayment || 0 }} TND</span>
      </div>
      <div>
        <span class="block text-gray-500 text-xs">Reste à payer</span>
        <span class="text-xl font-bold text-red-600">{{ (reservation?.totalAmount || 0) - (reservation?.advancePayment || 0) }} TND</span>
      </div>
    </div>

    <form [formGroup]="clientPaymentForm" (ngSubmit)="addClientPayment()" class="flex gap-4 items-end mb-6">
      <div class="flex-1">
        <label class="block text-sm font-medium text-gray-700">Montant</label>
        <input type="number" formControlName="amount" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 border p-2">
      </div>
      <div class="flex-1">
        <label class="block text-sm font-medium text-gray-700">Mode</label>
        <select formControlName="method" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 border p-2">
          <option value="ESPECES">Espèces</option>
          <option value="CHEQUE">Chèque</option>
          <option value="VIREMENT">Virement</option>
        </select>
      </div>
      <button type="submit" [disabled]="clientPaymentForm.invalid" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 disabled:opacity-50">
        Ajouter
      </button>
    </form>

    <table class="min-w-full divide-y divide-gray-200">
      <thead>
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Montant</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Mode</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <tr *ngFor="let payment of reservation?.clientPayments">
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ payment.date | date:'dd/MM/yyyy' }}</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{{ payment.amount }} TND</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ payment.method }}</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div *ngIf="activeTab === 'partner'">
    <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-semibold text-gray-800">Gestion des Partenaires</h3>
        <button (click)="printAllPartnersState()" class="text-sm bg-gray-100 text-gray-700 hover:bg-gray-200 px-3 py-2 rounded border border-gray-300 flex items-center">
            🖨️ Imprimer Bilan Global
        </button>
    </div>

    <div *ngFor="let p of groupedPartners" class="mb-6 border rounded-lg overflow-hidden shadow-sm">
        <div class="bg-gray-50 px-4 py-3 border-b flex justify-between items-center">
            <div>
                <span class="font-bold text-gray-800 text-lg">{{ p.partnerName }}</span>
                <p class="text-xs text-gray-500">Services: {{ p.services.join(', ') }}</p>
            </div>
            <div class="text-right">
                <p class="text-xs text-gray-500">Total Dû</p>
                <p class="font-bold">{{ p.totalCost }} TND</p>
            </div>
        </div>
        
        <div class="p-4 bg-white grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <div class="flex justify-between text-sm mb-2">
                    <span>Déjà payé:</span>
                    <span class="text-green-600 font-medium">{{ p.totalPaid }} TND</span>
                </div>
                <div class="flex justify-between text-sm mb-4 border-t pt-2">
                    <span>Reste à payer:</span>
                    <span class="font-bold" [ngClass]="{'text-red-500': p.remaining > 0, 'text-green-500': p.remaining <= 0}">
                        {{ p.remaining }} TND
                    </span>
                </div>
            </div>

            <div class="bg-gray-50 p-3 rounded">
                <p class="text-xs font-bold text-gray-400 uppercase mb-2">Nouveau règlement</p>
                <form [formGroup]="partnerPaymentForm" (ngSubmit)="addPartnerPayment()" *ngIf="partnerPaymentForm.value.partnerId === p.partnerId || !partnerPaymentForm.value.partnerId">
                    <div class="flex gap-2 mb-2">
                        <input type="hidden" [ngModel]="p.partnerId" formControlName="partnerId">
                        
                        <input type="number" formControlName="amount" placeholder="Montant" 
                               (focus)="partnerPaymentForm.patchValue({partnerId: p.partnerId})"
                               class="w-1/3 text-sm border-gray-300 rounded p-1">
                               
                        <select formControlName="method" class="w-1/3 text-sm border-gray-300 rounded p-1">
                            <option value="ESPECES">Espèces</option>
                            <option value="CHEQUE">Chèque</option>
                            <option value="VIREMENT">Virement</option>
                        </select>
                        
                        <button type="submit" [disabled]="partnerPaymentForm.invalid || partnerPaymentForm.value.partnerId !== p.partnerId" 
                                class="bg-green-600 hover:bg-green-700 text-white text-xs px-3 rounded flex-1">
                            Payer
                        </button>
                    </div>
                    <input type="text" formControlName="reference" placeholder="Référence (N° Chèque/Virement)" 
                           class="w-full text-xs border-gray-300 rounded p-1 mt-1">
                </form>
            </div>
        </div>

        <div class="px-4 py-2 bg-gray-50 border-t" *ngIf="reservation?.partnerPayments">
             <p class="text-xs font-semibold text-gray-500 mb-2">Historique</p>
             <div *ngFor="let pay of reservation?.partnerPayments">
                 <div *ngIf="pay.partnerId === p.partnerId" class="flex justify-between items-center text-xs py-1 border-b last:border-0 border-gray-200">
                     <span>{{ pay.date | date:'dd/MM HH:mm' }} - {{ pay.method }}</span>
                     <div class="flex items-center gap-2">
                         <span class="font-bold">{{ pay.amount }} TND</span>
                         <button (click)="printPartnerReceipt(pay)" class="text-blue-500 hover:underline" title="Imprimer le reçu">🖨️</button>
                     </div>
                 </div>
             </div>
        </div>
    </div>

    <div *ngIf="groupedPartners.length === 0" class="text-center py-8 text-gray-500">
        Aucun service avec partenaire assigné dans cette réservation.
    </div>

  </div>
</div>
