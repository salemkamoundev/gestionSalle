<div class="max-w-6xl mx-auto bg-white p-8 rounded-2xl shadow-xl mt-6 border border-slate-100">
  <div class="flex justify-between items-center mb-8 border-b pb-4">
    <h2 class="text-2xl font-black text-slate-800 flex items-center">
      <span class="material-icons mr-3 text-blue-600">event_available</span>
      {{ isEditMode() ? 'Modifier la Réservation' : 'Nouvelle Réservation' }}
    </h2>
    <div class="flex gap-2">
      @if (isEditMode()) {
        <button type="button" (click)="onPrint()" class="flex items-center gap-2 px-4 py-2 bg-purple-600 text-white rounded-lg font-bold shadow-md hover:bg-purple-700 transition">
          <span class="material-icons text-sm">print</span> Imprimer Contrat
        </button>

        <button type="button" (click)="openPaymentModal()"
          class="flex items-center gap-2 px-4 py-2 rounded-lg font-bold shadow-md bg-emerald-600 text-white hover:bg-emerald-700 transition">
          <span class="material-icons text-sm">payments</span>
          Règlement
        </button>

      }
      <button type="button" (click)="onClose()" class="text-slate-400 hover:text-slate-600 p-2">
        <span class="material-icons">close</span>
      </button>
    </div>
  </div>

  <form [formGroup]="form" (ngSubmit)="onSubmit()" class="space-y-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <div class="space-y-6">
        <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest border-l-4 border-blue-500 pl-2">Informations & Client</h3>

<!-- CLIENT_DETAILS_IN_RESERVATION_UI -->
@if (selectedClient()) {
  <div class="mt-3 p-4 rounded-2xl border bg-white shadow-sm">
    <div class="flex items-center gap-2 border-b pb-3 mb-3">
      <span class="material-icons text-emerald-600">person</span>
      <h4 class="text-base font-black text-slate-800">Détails du client</h4>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
      <div><span class="text-slate-500">Nom :</span> <span class="font-semibold text-slate-800">{{ selectedClient()?.nom || selectedClient()?.lastName || '-' }}</span></div>
      <div><span class="text-slate-500">Prénom :</span> <span class="font-semibold text-slate-800">{{ selectedClient()?.prenom || selectedClient()?.firstName || '-' }}</span></div>

      <div><span class="text-slate-500">Téléphone :</span> <span class="font-semibold text-slate-800">{{ selectedClient()?.telephone || selectedClient()?.tel || selectedClient()?.phone || '-' }}</span></div>
      <div><span class="text-slate-500">Email :</span> <span class="font-semibold text-slate-800">{{ selectedClient()?.email || '-' }}</span></div>

      <div class="md:col-span-2"><span class="text-slate-500">Adresse :</span> <span class="font-semibold text-slate-800">{{ selectedClient()?.adresse || selectedClient()?.address || '-' }}</span></div>

      <div><span class="text-slate-500">Ville :</span> <span class="font-semibold text-slate-800">{{ selectedClient()?.ville || selectedClient()?.city || '-' }}</span></div>
      <div><span class="text-slate-500">Code postal :</span> <span class="font-semibold text-slate-800">{{ selectedClient()?.codePostal || selectedClient()?.postalCode || selectedClient()?.cp || '-' }}</span></div>

      <div><span class="text-slate-500">CIN :</span> <span class="font-semibold text-slate-800">{{ selectedClient()?.cin || selectedClient()?.cinNumber || '-' }}</span></div>
      <div><span class="text-slate-500">Société :</span> <span class="font-semibold text-slate-800">{{ selectedClient()?.societe || selectedClient()?.company || '-' }}</span></div>

      <div class="md:col-span-2"><span class="text-slate-500">Notes :</span> <span class="font-semibold text-slate-800">{{ selectedClient()?.notes || selectedClient()?.note || '-' }}</span></div>
    </div>
  </div>
}


        
        <div class="space-y-4">
          <div>
            <label class="block text-[10px] font-black text-slate-500 uppercase mb-1">Date</label>
            <input formControlName="date" type="date" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-blue-500 outline-none">
          </div>
          
          <div>
            <label class="block text-[10px] font-black text-slate-500 uppercase mb-1">Créneau Disponible</label>
            <select formControlName="selectedSlotId" (change)="onSlotChange($event)" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white outline-none">
              <option value="">Sélectionner un créneau...</option>
              @for (slot of availableSlots(); track slot.id) {
                <option [value]="slot.id">{{ slot.label }} ({{ slot.start }} - {{ slot.end }})</option>
              }
            </select>
          </div>
        </div>

        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
          <div class="flex items-center justify-between gap-3 mb-2">
            <label class="block text-[10px] font-black text-blue-600 uppercase">Rechercher le Client</label>
            <button type="button"
              (click)="openClientModal()"
              class="text-[10px] font-black px-2 py-1 rounded-lg border border-blue-200 text-blue-700 bg-white hover:bg-blue-50 transition flex items-center gap-1">
              <span class="material-icons text-[14px]">person_add</span>
              Nouveau
            </button>
          </div>
          <div class="relative mb-3">
            <input type="text" [value]="clientSearch()" (input)="onClientSearch($event)" placeholder="Nom, Prénom ou Téléphone..." class="w-full px-4 py-2 pr-10 rounded-lg border border-slate-200 outline-none focus:border-blue-400">
            @if (clientSearch()) {
              <button type="button" (click)="clearClientSearch()" class="absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-white border border-slate-200 text-slate-400 hover:text-slate-600 hover:bg-slate-50 flex items-center justify-center shadow-sm" aria-label="Vider la recherche client">
                <span class="material-icons text-[16px]">close</span>
              </button>
            }
          </div>
          <div class="max-h-48 overflow-y-auto space-y-1 custom-scrollbar">
            @for (c of filteredClients(); track c.id) {
              <div (click)="selectClient(c)" 
                   class="p-3 rounded-xl cursor-pointer border transition-all"
                   [class.bg-white]="form.value.clientId === c.id"
                   [class.border-blue-500]="form.value.clientId === c.id"
                   [class.border-transparent]="form.value.clientId !== c.id"
                   [class.hover:bg-blue-50]="form.value.clientId !== c.id">
                <div class="font-bold text-slate-800 text-sm">{{ c.nom }} {{ c.prenom }}</div>
                <div class="text-[10px] text-slate-500 flex items-center mt-0.5">
                  <span class="material-icons text-[12px] mr-1 text-slate-400">phone</span> {{ c.telephone }}
                </div>
              </div>
            }
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest border-l-4 border-emerald-500 pl-2">Finances</h3>
        
        <div class="space-y-4">
          <div class="p-4 bg-emerald-50 rounded-2xl border border-emerald-100">
            <label class="block text-[10px] font-black text-emerald-700 uppercase mb-1">Prix Total (DT)</label>
            <input formControlName="totalPrice" type="number" class="w-full bg-transparent font-black text-xl text-emerald-900 border-none outline-none">
          </div>

          <div class="p-4 bg-blue-50 rounded-2xl border border-blue-100">
            <label class="block text-[10px] font-black text-blue-700 uppercase mb-1">Avance (DT)</label>
            <input formControlName="advance" type="number" class="w-full bg-transparent font-black text-xl text-blue-900 border-none outline-none">
          </div>

          <div class="p-4 bg-slate-100 rounded-2xl text-center">
            <span class="text-[10px] font-black text-slate-400 uppercase">Reste à payer</span>
            <div class="text-2xl font-black text-slate-800">
              {{ (form.value.totalPrice || 0) - (form.value.advance || 0) }} DT
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest border-l-4 border-purple-500 pl-2">Équipes & Personnel</h3>
        
        <div class="space-y-2">
          <label class="text-[10px] font-black text-slate-500 uppercase">Prestataires sélectionnés ({{ (form.value.assignedTeamIds || []).length }})</label>
          <input type="text" (input)="teamSearch.set($any($event.target).value)" placeholder="Filtrer prestataires..." class="w-full px-3 py-1.5 text-xs rounded-lg border border-slate-100 mb-2 outline-none focus:border-purple-300">          <div class="grid grid-cols-1 gap-2 max-h-48 overflow-y-auto pr-2 custom-scrollbar">
            @for (team of filteredTeams(); track team.id) {
              <div (click)="toggleTeam(team.id!)" 
                   class="flex items-center justify-between p-3 rounded-xl border cursor-pointer transition-all"
                   [class.border-purple-500]="isTeamSelected(team.id!)" 
                   [class.bg-purple-50]="isTeamSelected(team.id!)"
                   [class.border-slate-100]="!isTeamSelected(team.id!)">
                <span class="text-xs font-bold text-slate-700">{{ team.nom }}</span>
                @if(isTeamSelected(team.id!)) {
                  <span class="material-icons text-purple-600 text-sm">check_circle</span>
                }
              </div>
            }
          </div>
        </div>

        <div class="space-y-2 pt-4">
          <label class="text-[10px] font-black text-slate-500 uppercase">Personnel de Salle ({{ (form.value.assignedServerIds || []).length }})</label>
          <input type="text" (input)="staffSearch.set($any($event.target).value)" placeholder="Filtrer staff..." class="w-full px-3 py-1.5 text-xs rounded-lg border border-slate-100 mb-2 outline-none focus:border-emerald-300">          <div class="grid grid-cols-2 gap-2 max-h-48 overflow-y-auto pr-2 custom-scrollbar">
            @for (staff of filteredStaff(); track staff.id) {
              <div (click)="toggleStaff(staff.id!)" 
                   class="p-2 rounded-lg border text-[10px] font-black text-center cursor-pointer transition-all"
                   [class.border-emerald-500]="isStaffSelected(staff.id!)" 
                   [class.bg-emerald-50]="isStaffSelected(staff.id!)"
                   [class.border-slate-100]="!isStaffSelected(staff.id!)">
                {{ staff.nom }}
              </div>
            }
          </div>
        </div>
      </div>
    </div>

    <div class="flex justify-end gap-3 pt-8 border-t border-slate-100">
      <button type="button" (click)="onClose()" class="px-8 py-3 text-slate-500 font-bold hover:bg-slate-50 rounded-xl transition">Annuler</button>
      <button type="submit" [disabled]="form.invalid" class="px-12 py-3 bg-slate-900 text-white rounded-xl font-black shadow-xl hover:scale-[1.02] active:scale-[0.98] transition disabled:opacity-30">
        {{ isEditMode() ? 'Mettre à jour' : 'Enregistrer la Réservation' }}
      </button>
    </div>
  </form>


@if (showClientModal()) {
  <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40" (click)="closeClientModal()"></div>

    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-2xl border border-slate-200 animate-fade-in max-h-[90vh] flex flex-col overflow-hidden">
      <div class="flex items-center justify-between px-5 py-3 border-b border-slate-100">
        <div class="flex items-center gap-2">
          <span class="material-icons text-blue-600">person_add</span>
          <h3 class="font-black text-slate-800">Nouveau client</h3>
        </div>
        <button type="button" (click)="closeClientModal()" class="text-slate-400 hover:text-slate-600 p-1">
          <span class="material-icons">close</span>
        </button>
      </div>

      <div class="p-5 overflow-y-auto flex-1">
        <app-client-form [isModal]="true" (finish)="onClientModalFinish($event)"></app-client-form>
      </div>
    </div>
  </div>
}

</div>

