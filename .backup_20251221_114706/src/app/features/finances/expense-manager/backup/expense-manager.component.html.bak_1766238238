<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden mt-6">
  <div class="px-6 py-4 border-b border-slate-100 bg-slate-50 flex justify-between items-center">
    <h3 class="font-bold text-slate-800 flex items-center gap-2">
      <span class="material-icons text-emerald-600">payments</span>
      Gestion des Dépenses & Prestataires
    </h3>
    <button (click)="loadExpenses()" class="text-slate-400 hover:text-blue-600 transition">
      <span class="material-icons">refresh</span>
    </button>
  </div>

  <div class="p-6 space-y-6">
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-blue-50 p-4 rounded-xl border border-blue-100">
        <div class="text-[10px] font-black uppercase text-blue-400 tracking-wider">Coût Pack</div>
        <div class="text-2xl font-black text-blue-800">{{ totalPack() }} DT</div>
      </div>
      
      <div class="bg-emerald-50 p-4 rounded-xl border border-emerald-100">
        <div class="text-[10px] font-black uppercase text-emerald-400 tracking-wider">Déjà Payé</div>
        <div class="text-2xl font-black text-emerald-800">{{ totalPaid() }} DT</div>
      </div>

      <div class="bg-rose-50 p-4 rounded-xl border border-rose-100">
        <div class="text-[10px] font-black uppercase text-rose-400 tracking-wider">Reste à Payer</div>
        <div class="text-2xl font-black text-rose-800">{{ totalRemaining() }} DT</div>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left">
        <thead class="text-xs text-slate-500 uppercase bg-slate-50 border-b border-slate-100">
          <tr>
            <th class="px-4 py-3">Bénéficiaire</th>
            <th class="px-4 py-3">Type</th>
            <th class="px-4 py-3 text-right">Montant</th>
            <th class="px-4 py-3 text-center">Statut</th>
            <th class="px-4 py-3 text-center">Action</th>
          </tr>
        </thead>
        <tbody>
          @for (expense of expenses(); track expense.id) {
            <tr class="border-b border-slate-50 hover:bg-slate-50 transition">
              <td class="px-4 py-3 font-medium text-slate-700">
                {{ expense.beneficiaryName }}
                @if(expense.note) { <div class="text-[10px] text-slate-400">{{ expense.note }}</div> }
              </td>
              <td class="px-4 py-3">
                <span class="px-2 py-1 rounded-md text-[10px] font-bold border"
                  [ngClass]="{
                    'bg-indigo-50 text-indigo-700 border-indigo-100': expense.type === 'PACK_ITEM',
                    'bg-orange-50 text-orange-700 border-orange-100': expense.type === 'STAFF',
                    'bg-slate-50 text-slate-700 border-slate-200': expense.type === 'AUTRE'
                  }">
                  {{ expense.type }}
                </span>
              </td>
              <td class="px-4 py-3 text-right font-mono font-bold text-slate-700">
                {{ expense.amount }} DT
              </td>
              <td class="px-4 py-3 text-center">
                <span class="px-2 py-1 rounded-full text-[10px] font-bold flex items-center justify-center gap-1 w-fit mx-auto"
                  [ngClass]="{
                    'bg-emerald-100 text-emerald-700': expense.status === 'PAYE',
                    'bg-amber-100 text-amber-700': expense.status === 'A_PAYER'
                  }">
                  @if(expense.status === 'PAYE') { <span class="material-icons text-[12px]">check</span> }
                  @else { <span class="material-icons text-[12px]">schedule</span> }
                  {{ expense.status === 'PAYE' ? 'RÉGLÉ' : 'EN ATTENTE' }}
                </span>
              </td>
              <td class="px-4 py-3 text-center">
                <button (click)="togglePayment(expense)" 
                  class="text-[10px] font-bold px-3 py-1.5 rounded-lg border transition hover:shadow-sm"
                  [ngClass]="expense.status === 'PAYE' ? 'bg-white border-slate-200 text-slate-500' : 'bg-emerald-600 text-white border-transparent hover:bg-emerald-700'">
                  {{ expense.status === 'PAYE' ? 'Annuler' : 'Payer' }}
                </button>
              </td>
            </tr>
          } @empty {
            <tr>
              <td colspan="5" class="text-center py-8 text-slate-400 italic">
                Aucune dépense enregistrée pour cette réservation.
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>
