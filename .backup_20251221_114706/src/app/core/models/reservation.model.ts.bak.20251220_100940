export interface Reservation {
  id?: string;
  clientId: string;
  clientName?: string;
  date: string;
  startTime: string;
  endTime: string;
  
  assignedServerIds?: string[]; // Staff interne
  assignedTeamIds?: string[];   // Équipes externes (Multiple)
  
  selectedSlotId?: string;
  

  // NOUVEAU: pack + services sélectionnés dans le formulaire
  packId?: string | null;
  packName?: string | null;

  // IDs des services du catalogue (collection 'services')
  serviceIds?: string[];

  // Snapshot (optionnel) pour affichage / impression
  servicesSnapshot?: { id: string; nom: string; prix?: number }[];

  notes?: string;
  status: 'CONFIRMED' | 'PENDING' | 'CANCELLED';
  totalPrice?: number;
  advance?: number;
  advanceOnly?: boolean;
  createdAt?: string;
}
